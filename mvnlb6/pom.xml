<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>mvnlb6</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Archetype - mvnlb6</name>
  <url>http://maven.apache.org</url>

  <!-- Список всех модулей -->
  <modules>
    <module>shared</module>
    <module>server</module>
    <module>client</module>
  </modules>

  <!-- Свойства компилятора -->
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <!-- Общие зависимости, которые могут быть унаследованы модулями -->
  <dependencyManagement>
    <dependencies>
      <!-- Зависимость на SLF4J API -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.0</version>
      </dependency>
      <!-- Реализация SLF4J (например, slf4j-simple для логирования) -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>2.0.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Зависимости, которые должны быть доступны всем модулям -->
  <dependencies>
    <!-- Зависимости, которые могут быть общими для всех модулей -->
  </dependencies>
</project>